# Copy to .env (git-ignored) and fill in, or export these in your shell.
# Nothing here is read automatically: the scripts read environment variables, so either export them
# or use a loader of your choice.

# --- required for anything that touches external data ------------------------------------------
# Folder holding the inputs that are not in this repository: CORINE, the PNACC NetCDFs, the station
# tables, the Cieza workbook. Structure described in 00_data/README.md.
PLINIUS_DATA=/path/to/plinius_data

# --- required only for 21_aemet_observed_download.py -------------------------------------------
# Personal key, free from https://opendata.aemet.es/centrodedescargas/altaUsuario
# It expires every three months; a sudden run of 401s usually means it lapsed rather than broke.
AEMET_API_KEY=

# --- optional overrides -------------------------------------------------------------------------
# Repository root, if it should not be inferred from the scripts' own location.
# PLINIUS_ROOT=/path/to/this/repo
# The CORINE GeoTIFF, if it does not sit under PLINIUS_DATA or if several match. The Copernicus
# download also ships the French overseas departments, so an explicit path removes the ambiguity.
# PLINIUS_CLC=/path/to/U2018_CLC2018_V2020_20u1.tif
# DM_JOSE.R, which is not distributed here. See 00_data/README.md and THIRD_PARTY.md.
# PLINIUS_DM=/path/to/DM_JOSE.R
