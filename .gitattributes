# Line endings, decided here rather than per machine.
#
# `core.autocrlf` is local configuration: it does not travel with a clone, so relying on it means
# the repository behaves differently depending on who committed and from where. This file travels,
# and overrides it everywhere.
#
# The concrete failure it prevents: scripts 14, 15 and 21 are uploaded to an HPC and run under
# Linux. A shell script checked out with CRLF fails there with `$'\r': command not found`, and the
# message points at the shell rather than at the line endings, which is why it wastes an afternoon.
# Anything that can end up on a Linux box is pinned to LF in the working tree, not just in the
# repository.

# Normalise everything Git recognises as text to LF inside the repository.
* text=auto

# --- pinned to LF in the working tree too, on every platform ------------------------------------
*.sh    text eol=lf
*.py    text eol=lf
*.R     text eol=lf
*.Rmd   text eol=lf
*.r     text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cff   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.env.example   text eol=lf
LICENSE        text eol=lf

# --- binary: never touched, never diffed as text ------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.pptx  binary
*.docx  binary
*.zip   binary
*.gz    binary
*.nc    binary
*.tif   binary
*.tiff  binary
*.RData binary
*.rds   binary

# --- diff behaviour ------------------------------------------------------------------------------
# Long generated tables produce unreadable diffs; marking them keeps `git log -p` usable.
02_outputs/*.csv -diff
